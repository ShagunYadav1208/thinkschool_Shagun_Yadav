{
  // Overrides the base appsettings.json's "localhost:6379" - that assumes a
  // local Docker Redis that isn't actually running in this dev session
  // (confirmed live: nothing listening there). Empty here makes
  // InfrastructureExtensions.cs take its AddDistributedMemoryCache branch
  // instead - zero network calls for the cache's L2, not just a fast
  // failure. If you do want to exercise the real Redis L2 locally, start a
  // container (see README's Day 21 "Redis backing" note) and remove this
  // override.
  "Redis": {
    "ConnectionString": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
