{
  // ConnectionStrings, ServiceBus, and Cors are deliberately absent here -
  // an earlier version of this file hardcoded a specific server/namespace
  // name, which silently went stale the moment a later exercise provisioned
  // its own SQL server/Service Bus namespace under a different name (see
  // day-25's own fix for the same bug). infra/main.bicep now supplies
  // ConnectionStrings__DefaultConnection, ServiceBus__FullyQualifiedNamespace
  // (+ TopicName/AuditLogSubscription/NotificationsSubscription), and
  // Cors__AllowedOrigin directly as App Service settings, built from that
  // same deployment's own real resource names - see main.bicep's `api`
  // module. Nothing in source can point at the wrong server again.
  //
  // AppInsights__ConnectionString is likewise absent - it arrives the same
  // way, from infra/modules/appinsights.bicep's output, wired into the `api`
  // module's extraAppSettings.
  "Redis": {
    "ConnectionString": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
