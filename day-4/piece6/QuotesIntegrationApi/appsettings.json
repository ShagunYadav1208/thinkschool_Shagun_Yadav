{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=quotes-integration.db"
  },
  "Jwt": {
    "Issuer": "QuotesIntegrationApi",
    "Audience": "QuotesIntegrationApi.Client",
    "AccessTokenLifetime": "00:15:00"
  },
  "QuoteValidation": {
    "MaxAuthorLength": 100,
    "MaxTextLength": 1000
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{TraceId}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext"]
  },
  "AllowedHosts": "*"
}
